# ==============================================================================
# RX-Emby 环境变量配置模板（复制为 .env 后按需修改）
# 说明：
#   1. POSTGRES_PASSWORD 为必填项，未设置时 docker compose 将拒绝启动。
#   2. 同步/AList/TMDB/缓存参数在首次启动后会持久化至数据库，后续可在 Web 后台「系统设置」中热修改。
# ==============================================================================

TZ=Asia/Shanghai
RUST_LOG=rx_emby=info
# 服务监听端口（host 网络模式下直接监听在宿主机，默认 23486 以避开原版 Emby 的 8096）
HTTP_PORT=23486

# 1. PostgreSQL 数据库配置（仅绑定宿主机 127.0.0.1，默认 15432 避开飞牛/NAS 系统自带的 5432）
POSTGRES_PORT=15432
POSTGRES_USER=media_admin
POSTGRES_DB=xiaoya_media
POSTGRES_PASSWORD=rx_emby_strong_password

# 2. 服务端基础配置
SERVER_ID=rx-emby
SERVER_NAME=RX-Emby

# 3. 宿主机持久化与小雅目录映射
XIAOYA_DIR=/vol1/1000/xiaoya
PG_DATA_DIR=./pg_data
CACHE_DIR=./cache

# 4. 媒体库同步配置
STRM_TXT_SOURCE=/xiaoya-db/strm.txt
SYNC_INTERVAL_SEC=21600
PARSE_CONCURRENCY=16
DB_BATCH_SIZE=5000
SYNC_INCLUDE_PREFIXES=
SYNC_EXCLUDE_KEYWORDS=演唱会,短剧,广播剧
SYNC_MAX_LINES_LIMIT=0

# 5. 小雅 / AList 服务配置（host 模式下请填 NAS 局域网 IP + 小雅端口，勿填容器名）
ALIST_BASE_URL=http://192.168.1.10:5678
ALIST_USERNAME=alist
ALIST_PASSWORD=your_alist_password
ALIST_OTP_SECRET=
ALIST_PATH_PREFIX=
ALIST_DIRECT_URL_TTL_SEC=600

# 6. TMDB 刮削配置（host 模式下代理请填 127.0.0.1:<端口> 或代理容器静态 IP，勿填容器名；直连可留空）
SCRAPER_AUTO_BACKGROUND=false
TMDB_API_KEY=your_tmdb_api_key
TMDB_PROXY_URL=
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_RATE_LIMIT_PER_SEC=4

# 7. 本地图片缓存配置
IMAGE_CACHE_DIR=./cache/images
IMAGE_CACHE_MAX_SIZE_MB=20480
IMAGE_CACHE_EVICT_HIGH_WATERMARK=0.90
IMAGE_CACHE_EVICT_LOW_WATERMARK=0.75
